#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
};

/ {
    combos { compatible = "zmk,combos"; };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            global-quick-tap;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <600>;
            global-quick-tap;
            quick-tap-ms = <400>;
        };

        LayerChange: LayerChange {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYERCHANGE";
            bindings = <&mo>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q            &kp W             &kp E             &kp R  &kp T      &kp Y                     &kp U  &kp I      &kp O    &kp P
&kp A            &kp S             &kp D             &kp F  &kp G      &kp H                     &kp J  &kp K      &kp L    &kp SEMICOLON
&kp Z            &kp X             &kp C             &kp V  &kp B      &kp N                     &kp M  &kp COMMA  &kp DOT  &kp FSLH
       &kp LGUI         &kp LCTRL         &kp SPACE         &kp SPACE  &kp LALT  &kp LEFT_SHIFT
            >;
        };

        lower_layer {
            bindings = <
&kp TAB                 &kp CAPS                 &kp PAGE_UP           &trans        &trans          &kp PRINTSCREEN         &none         &kp UP_ARROW    &kp BACKSPACE  &none
&kp ENTER               &kp HOME                 &kp PAGE_DOWN         &kp END       &trans          &kp DELETE              &kp LEFT      &kp DOWN_ARROW  &kp RIGHT      &kp SPACE
&kp NUMBER_1            &kp NUMBER_2             &kp NUMBER_3          &kp NUMBER_4  &kp NUMBER_5    &kp NUMBER_6            &kp NUMBER_7  &kp NUMBER_8    &kp NUMBER_9   &kp NUMBER_0
              &kp LGUI                &kp LCTRL                 &to 0                &kp LEFT_SHIFT  &kp LALT         &mo 3
            >;
        };

        raise_layer {
            bindings = <
&bt BT_SEL 0                   &bt BT_SEL 1             &bt BT_SEL 2          &bt BT_SEL 3  &bt BT_SEL 4    &trans               &bt BT_PRV      &bt BT_NXT  &bt BT_CLR         &bt BT_CLR_ALL
&kp EXCLAMATION                &kp AT_SIGN              &kp HASH              &kp DOLLAR    &kp BACKSLASH   &none                &kp MINUS       &kp EQUAL   &kp SINGLE_QUOTE   &kp GRAVE
&kp PERCENT                    &kp CARET                &kp AMPERSAND         &kp ASTERISK  &kp PIPE        &none                &kp UNDERSCORE  &kp PLUS    &kp DOUBLE_QUOTES  &kp TILDE
                 &kp LEFT_GUI                &kp LCTRL                 &mo 3                &kp LEFT_SHIFT  &kp LEFT_ALT  &to 0
            >;
        };

        adjust_layer {
            bindings = <
&kp F1                    &kp F2                         &kp F3                            &kp F4             &kp F5      &kp F6                        &kp F7  &kp F8  &kp F9   &kp F10
&trans                    &trans                         &kp C_BRIGHTNESS_INC              &kp C_VOLUME_UP    &trans      &trans                        &trans  &trans  &kp F11  &kp F12
&sys_reset                &bootloader                    &kp C_BRIGHTNESS_DEC              &kp C_VOLUME_DOWN  &kp C_MUTE  &trans                        &trans  &trans  &trans   &trans
            &kp LEFT_GUI               &kp LEFT_CONTROL                        &kp K_FIND                     &kp K_FIND  &kp LEFT_ALT  &kp LEFT_SHIFT
            >;
        };
    };
};
