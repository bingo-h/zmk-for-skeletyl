#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
};

/ {
    combos { compatible = "zmk,combos"; };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            global-quick-tap;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <600>;
            global-quick-tap;
            quick-tap-ms = <400>;
        };

        LayerChange: LayerChange {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYERCHANGE";
            bindings = <&mo>, <&to>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    macros {
        c0: c0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(SPACE)>;
            label = "C0";
        };

        c8: c8 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(UP_ARROW)>;
            label = "C8";
        };

        c6: c6 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LEFT)>;
            label = "C6";
        };

        c7: c7 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(DOWN)>;
            label = "C7";
        };

        c9: c9 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(RIGHT)>;
            label = "C9";
        };

        c10: c10 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(F)>;
            label = "C10";
        };

        c11: c11 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(MINUS)>;
            label = "C11";
        };

        c12: c12 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(EQUAL)>;
            label = "C12";
        };

        c13: c13 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(UNDERSCORE)>;
            label = "C13";
        };

        c14: c14 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(PLUS)>;
            label = "C14";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q                       &kp W                      &kp F               &kp P        &kp G        &kp J                     &kp L        &kp U            &kp Y             &kp SEMICOLON
&hm LEFT_GUI A              &hm LEFT_ALT R             &hm LCTRL S         &hm LSHFT T  &kp D        &kp H                     &kp N        &kp E            &kp I             &kp O
&kp Z                       &kp X                      &kp C               &kp V        &kp B        &kp K                     &hm LSHFT M  &hm LCTRL COMMA  &hm LEFT_ALT DOT  &hm LEFT_GUI SLASH
                &kp ESCAPE                  &lt 2 TAB               &mo 1               &lt 1 ENTER  &kp SPACE  &kp BACKSPACE
            >;
        };

        lower_layer {
            bindings = <
&kp LEFT_PARENTHESIS          &kp RIGHT_PARENTHESIS          &kp SINGLE_QUOTE       &kp DOUBLE_QUOTES  &kp PRINTSCREEN  &kp TILDE              &kp PIPE   &kp UP_ARROW    &kp UNDERSCORE  &kp PLUS
&kp LEFT_BRACKET              &kp RIGHT_BRACKET              &kp LEFT_BRACE         &kp RIGHT_BRACE    &kp GRAVE        &kp BACKSLASH          &kp LEFT   &kp DOWN_ARROW  &kp RIGHT       &kp MINUS
&kp EXCLAMATION               &kp AT_SIGN                    &kp HASH               &kp DOLLAR         &kp DEL          &kp PERCENT            &kp CARET  &kp AMPERSAND   &kp STAR        &kp EQUAL
                      &trans                         &trans                    &c0                     &c0              &trans         &trans
            >;
        };

        raise_layer {
            bindings = <
&trans                &trans                &c8                   &trans        &trans        &trans                      &trans        &kp PAGE_UP    &c13          &c14
&kp LEFT_GUI          &c6                   &c7                   &c9           &c10          &c12                        &kp HOME      &kp PAGE_DOWN  &kp END       &c11
&kp NUMBER_1          &kp NUMBER_2          &kp NUMBER_3          &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6                &kp NUMBER_7  &kp NUMBER_8   &kp NUMBER_9  &kp NUMBER_0
              &trans                &trans                &trans                &trans        &mo 3         &kp CAPSLOCK
            >;
        };

        adjust_layer {
            bindings = <
&kp F1                    &kp F2                         &kp F3                            &kp F4             &kp F5      &kp F6                        &kp F7        &kp F8        &kp F9        &kp F10
&trans                    &trans                         &kp C_BRIGHTNESS_INC              &kp C_VOLUME_UP    &trans      &trans                        &trans        &trans        &kp F11       &kp F12
&sys_reset                &bootloader                    &kp C_BRIGHTNESS_DEC              &kp C_VOLUME_DOWN  &kp C_MUTE  &bt BT_SEL 0                  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR
            &kp LEFT_GUI               &kp LEFT_CONTROL                        &kp K_FIND                     &kp K_FIND  &kp LEFT_ALT  &kp LEFT_SHIFT
            >;
        };
    };
};
